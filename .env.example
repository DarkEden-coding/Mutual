PORT=8787
DATA_DIR=./data
# Omit or leave empty to generate and persist DATA_DIR/secret.
SESSION_SECRET=
# At least 32 characters; generate with openssl rand -base64 32. Empty disables /admin.
ADMIN_TOKEN=
# Compose defaults to cloudflare. Use none for direct access without Cloudflare.
TRUST_PROXY=cloudflare
# Empty defaults to true in production, false otherwise. false permits HTTP testing.
COOKIE_SECURE=
# Origin for link previews, e.g. https://mutual.example.com. Empty derives it from the Host header.
PUBLIC_URL=
TUNNEL_TOKEN=
# NODE_ENV=production
# WEB_DIST=/absolute/path/to/web/dist
# Compose only: host port published on 127.0.0.1.
HOST_PORT=8787
